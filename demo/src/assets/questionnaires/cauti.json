                            }
                        ]
                    }
                ]
            },
            "item": [
                {
                    "linkId": "A1",
                    "type": "string",
                    "text": "Patienten-Nummer (PID)",
                    "required": true
                },
                {
                    "linkId": "A2",
                    "type": "string",
                    "text": "Fall-Nummer",
                    "required": false
                },
                {
                    "linkId": "A3",
                    "type": "choice",
                    "text": "Geschlecht",
                    "required": true,
                    "answerValueSet": "#gender-valueset"
                },
                {
                    "linkId": "A4",
                    "type": "choice",
                    "text": "Organisationseinheit",
                    "required": true,
                    "answerValueSet": "#org-unit-valueset"
                },
                {
                    "linkId": "A5",
                    "type": "date",
                    "text": "Eintrittsdatum ins Spital",
                    "required": true
                },
                {
                    "linkId": "A6",
                    "type": "date",
                    "text": "Austrittsdatum aus Spital",
                    "required": true
                },
                {
                    "linkId": "A7",
                    "type": "boolean",
                    "text": "Spital, das nur mit ausgewählten Organisationseinheiten teilnimmt"
                },
                {
                    "linkId": "A7a",
                    "type": "date",
                    "enableWhen": [
                        {
                            "question": "A7",
                            "operator": "=",
                            "answerBoolean": true
                        }
                    ],
                    "text": "Eintrittsdatum in die überwachten Organisationseinheiten (bei Spitälern, die nur mit ausgewählten Organisationseinheiten teilnehmen)"
                },
                {
                    "linkId": "A7b",
                    "type": "date",
                    "enableWhen": [
                        {
                            "question": "A7",
                            "operator": "=",
                            "answerBoolean": true
                        }
                    ],
                    "text": "Austrittsdatum aus der überwachten Organisationseinheiten (bei Spitälern, die nur mit ausgewählten Organisationseinheiten teilnehmen)"
                }
            ]
        },
