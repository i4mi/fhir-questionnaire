            "linkId": "A-patient-data",
            "type": "group",
            "text": "Angaben zum Patienten",
            "_text": {
                "extension": [
                    {
                        "url": "http://hl7.org/fhir/StructureDefinition/translation",
                        "extension": [
                            {
                                "url": "lang",
